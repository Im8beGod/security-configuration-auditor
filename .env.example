# ==========================================
# SIH 26155 - Development Environment
# ==========================================

APP_ENV=development

# Backend
APP_NAME=SIH 26155 Network Security Compliance Auditor
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1

# Frontend
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
# VITE_* values are embedded in browser code and must never contain secrets.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PostgreSQL
POSTGRES_DB=security_auditor
POSTGRES_USER=security_auditor
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# Authentication foundation (development placeholders only; replace locally).
JWT_SECRET=replace_with_a_long_random_secret_for_local_development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=sih26155_access_token
# Local HTTP requires false. HTTPS deployments must set this to true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/

# Runtime Storage
ARTIFACT_STORAGE_PATH=/app/storage/artifacts
REPORT_STORAGE_PATH=/app/storage/reports
# Step 4A upload limits: 10 MiB per file and 20 files per bulk request.
ARTIFACT_MAX_UPLOAD_BYTES=10485760
ARTIFACT_MAX_BULK_FILES=20

# Persistent worker runtime (minimum 0.1 seconds)
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_JOB_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
AI_MAPPING_SUGGESTIONS_ENABLED=false
AI_MAPPING_PROVIDER=ollama
# Docker Desktop host runtime; use http://localhost:11434 for a native backend.
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
AI_OLLAMA_TIMEOUT_SECONDS=120
