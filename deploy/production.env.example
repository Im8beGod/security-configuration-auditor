# Copy to a protected file on the VM and pass it with --env-file.
DOMAIN=auditor.example.com
APP_VERSION=production
APP_ENV=production

# Host ports for the Caddy frontend. Keep PostgreSQL private to Compose.
PRODUCTION_HTTP_PORT=80
PRODUCTION_HTTPS_PORT=443

POSTGRES_DB=security_auditor
POSTGRES_USER=security_auditor
# Set both values in the protected operator environment file. Empty values make
# Compose fail rather than accidentally accepting example credentials.
POSTGRES_PASSWORD=
JWT_SECRET=

# The Compose file derives FRONTEND_ORIGIN as https://${DOMAIN}; backend and
# worker use the shared named app_storage volume at /app/storage.

# Optional non-secret tuning.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_JOB_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
ARTIFACT_MAX_UPLOAD_BYTES=10485760
ARTIFACT_MAX_BULK_FILES=20
AI_MAPPING_SUGGESTIONS_ENABLED=false
